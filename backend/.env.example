# Copy to .env and adjust. Never commit the real .env.

# Local Postgres (Homebrew on 5432, or docker-compose on 5433) (Render injects its own DATABASE_URL; postgres:// is auto-converted)
DATABASE_URL=postgresql+asyncpg://coinscope:coinscope@localhost:5432/coinscope

# Used only by pytest
TEST_DATABASE_URL=postgresql+asyncpg://coinscope:coinscope@localhost:5432/coinscope_test

# Optional: fixed seed for reproducible simulator output (leave empty for random)
SIM_SEED=

# Simulator tick interval in seconds
SIM_TICK_SECONDS=10

# Disable the background simulator (useful for one-off scripts)
SIM_ENABLED=true

# Comma-separated list or * for all
CORS_ORIGINS=*

LOG_LEVEL=INFO

# Requests per minute per IP
RATE_LIMIT=120/minute
